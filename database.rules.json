          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16 && newData.val().matches(/^[A-Za-z0-9][A-Za-z0-9 ._'\\-]*$/) && !newData.val().toLowerCase().replace('0', 'o').replace('1', 'i').replace('3', 'e').replace('4', 'a').replace('5', 's').replace('6', 'g').replace('7', 't').replace('8', 'b').replace('9', 'g').replace(' ', '').replace('.', '').replace('_', '').replace('-', '').replace(\"'\", '').matches(/.*(n+i+g+g+e+r+|n+i+g+g+a+|f+a+g+g+o+t+|r+e+t+a+r+d+|h+e+i+l+h+i+t+l+e+r+|w+h+i+t+e+p+o+w+e+r+|w+h+i+t+e+s+u+p+r+e+m+a+c+y+|f+u+c+k+|a+s+s+h+o+l+e+).*/) && !newData.val().toLowerCase().replace('0', 'o').replace('1', 'i').replace('3', 'e').replace('4', 'a').replace('5', 's').replace('6', 'g').replace('7', 't').replace('8', 'b').replace('9', 'g').replace(' ', '').replace('.', '').replace('_', '').replace('-', '').replace(\"'\", '').matches(/^[0-9]*(f+a+g+|k+i+k+e+|s+p+i+c+|c+h+i+n+k+|t+r+a+n+n+y+|n+a+z+i+|c+u+n+t+|b+i+t+c+h+|s+h+i+t+|p+o+r+n+|r+a+p+e+|r+a+p+i+s+t+|p+e+d+o+|p+e+d+o+p+h+i+l+e+)[0-9]*$/) && !(' ' + newData.val().toLowerCase().replace('0', 'o').replace('1', 'i').replace('3', 'e').replace('4', 'a').replace('5', 's').replace('6', 'g').replace('7', 't').replace('8', 'b').replace('9', 'g') + ' ').matches(/.*[ ._'\\-](f+a+g+|k+i+k+e+|s+p+i+c+|c+h+i+n+k+|t+r+a+n+n+y+|n+a+z+i+|c+u+n+t+|b+i+t+c+h+|s+h+i+t+|p+o+r+n+|r+a+p+e+|r+a+p+i+s+t+|p+e+d+o+|p+e+d+o+p+h+i+l+e+)[ ._'\\-].*/) && !newData.val().toLowerCase().replace(' ', '').replace('.', '').replace('_', '').replace('-', '').replace(\"'\", '').matches(/^[0-9]*(f+a+g+|k+i+k+e+|s+p+i+c+|c+h+i+n+k+|t+r+a+n+n+y+|n+a+z+i+|c+u+n+t+|b+i+t+c+h+|s+h+i+t+|p+o+r+n+|r+a+p+e+|r+a+p+i+s+t+|p+e+d+o+|p+e+d+o+p+h+i+l+e+)[0-9]*$/)"
        }
      }
    }
  }
}
