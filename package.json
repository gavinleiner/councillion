{
  "name": "councillion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 4173",
    "test": "node --import ./tests/question-data.mjs --test tests/*.test.js",
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "test:security": "firebase emulators:exec --only database --project demo-councillion \"node tests/database-security.mjs && node tests/party-network.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "esbuild": "^0.25.12",
    "firebase-tools": "^15.34.1",
    "happy-dom": "^21.0.4"
  },
  "dependencies": {
    "@firebase/app": "0.16.2",
    "firebase": "12.19.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
